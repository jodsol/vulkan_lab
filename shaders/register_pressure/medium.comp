#version 450

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 256
#endif

layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint elementCount;
    uint iterationCount;
} pushConstants;

layout(binding = 0) readonly buffer InputBuffer {
    float inputData[];
} inputBuffer;

layout(binding = 1) writeonly buffer OutputBuffer {
    float outputData[];
} outputBuffer;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    float base = inputBuffer.inputData[gid];
    float a0 = base + 0.0;
    float a1 = base + 1.0;
    float a2 = base + 2.0;
    float a3 = base + 3.0;
    float a4 = base + 4.0;
    float a5 = base + 5.0;
    float a6 = base + 6.0;
    float a7 = base + 7.0;

    for (uint i = 0; i < pushConstants.iterationCount; ++i) {
        float fi = float(i) * 0.00001;
        a0 = a0 * 1.00011 + a4 * 0.0001 + fi;
        a1 = a1 * 1.00012 + a5 * 0.0001 + fi;
        a2 = a2 * 1.00013 + a6 * 0.0001 + fi;
        a3 = a3 * 1.00014 + a7 * 0.0001 + fi;
        a4 = a4 * 0.99991 + a0 * 0.0001 - fi;
        a5 = a5 * 0.99992 + a1 * 0.0001 - fi;
        a6 = a6 * 0.99993 + a2 * 0.0001 - fi;
        a7 = a7 * 0.99994 + a3 * 0.0001 - fi;
    }

    outputBuffer.outputData[gid] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
}
